{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project-init rubric evaluation report",
  "type": "object",
  "required": ["schema_version", "evaluated_at", "results", "summary"],
  "properties": {
    "schema_version": { "type": "string" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill_path", "skill_name", "grade",
          "blocker_count", "major_count", "minor_count", "checks"
        ],
        "properties": {
          "skill_path": { "type": "string" },
          "skill_name": { "type": "string" },
          "grade": { "type": "string", "enum": ["S", "A", "B", "C", "F"] },
          "blocker_count": { "type": "integer", "minimum": 0 },
          "major_count": { "type": "integer", "minimum": 0 },
          "minor_count": { "type": "integer", "minimum": 0 },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id", "section", "item", "check_type", "severity", "passed", "evidence"
              ],
              "properties": {
                "id": { "type": "string" },
                "section": {
                  "type": "string",
                  "enum": ["타당성", "구조", "트리거", "콘텐츠", "리소스", "안전성"]
                },
                "item": { "type": "string" },
                "check_type": { "type": "string", "enum": ["rule", "model"] },
                "severity": { "type": "string", "enum": ["BLOCKER", "MAJOR", "MINOR"] },
                "passed": { "type": "boolean" },
                "evidence": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_skills", "grades"],
      "properties": {
        "total_skills": { "type": "integer", "minimum": 0 },
        "grades": {
          "type": "object",
          "properties": {
            "S": { "type": "integer" },
            "A": { "type": "integer" },
            "B": { "type": "integer" },
            "C": { "type": "integer" },
            "F": { "type": "integer" }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "autopilot:review 파이프라인 판정 스키마. .github/prompts/codex-pr-review.schema.json 의 공유 PR 리뷰 계약(5관점·4증거·신뢰도≥80·fingerprint)을 단일 출처로 재사용하고, 파이프라인 전용 필드(pipeline_verdict·acceptance_coverage·rework_brief)를 가산한다. 계약을 새로 지어내지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eligibility",
    "pipeline_verdict",
    "verdict",
    "confidence",
    "reviewed_context",
    "automation_safety",
    "acceptance_coverage",
    "findings",
    "rework_brief",
    "resolved_threads",
    "unresolved_threads",
    "skipped_duplicates",
    "context_requests"
  ],
  "properties": {
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "type": "string", "enum": ["reviewed", "skipped", "unavailable"] },
        "reason": { "type": "string" }
      }
    },
    "pipeline_verdict": {
      "$comment": "파이프라인 머지 게이트가 소비하는 단일 판정. 가산 필드.",
      "type": "string",
      "enum": ["approve", "request_changes", "unavailable"]
    },
    "verdict": {
      "$comment": "공유 계약 호환 verdict. request_changes 는 comment 로 매핑(공유 어휘에 변경요청 값 없음).",
      "type": "string",
      "enum": ["approve", "comment", "needs_context", "unavailable"]
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "reviewed_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_sha",
        "head_sha",
        "diff_truncated",
        "files_reviewed",
        "related_files_reviewed",
        "skipped_files"
      ],
      "properties": {
        "base_sha": { "type": "string" },
        "head_sha": { "type": "string" },
        "diff_truncated": { "type": "boolean" },
        "files_reviewed": { "type": "array", "items": { "type": "string" } },
        "related_files_reviewed": { "type": "array", "items": { "type": "string" } },
        "skipped_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "reason"],
            "properties": {
              "file": { "type": "string" },
              "reason": {
                "type": "string",
                "enum": ["generated", "lockfile", "too_large", "not_relevant", "binary", "other"]
              }
            }
          }
        }
      }
    },
    "automation_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_approve", "may_request_changes", "reason"],
      "properties": {
        "may_approve": { "type": "boolean" },
        "may_request_changes": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "acceptance_coverage": {
      "$comment": "SPEC 수용기준 재검증 커버리지. 가산 필드. unverified 가 비어있지 않으면 approve 금지.",
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "verified", "unverified"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "verified": { "type": "integer", "minimum": 0 },
        "unverified": { "type": "array", "items": { "type": "string" } }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "confidence_score",
          "review_perspective",
          "comment_type",
          "file",
          "line",
          "start_line",
          "title",
          "body",
          "suggestion",
          "fingerprint",
          "duplicate_of"
        ],
        "properties": {
          "severity": { "type": "string", "enum": ["blocking", "non_blocking", "question"] },
          "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "review_perspective": {
            "$comment": "공유 enum 에 파이프라인 lens① 'spec_compliance' 가산.",
            "type": "string",
            "enum": ["spec_compliance", "guideline", "bug", "history", "previous_pr", "code_comment", "cross_file"]
          },
          "comment_type": { "type": "string", "enum": ["inline"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "start_line": { "type": ["integer", "null"], "minimum": 1 },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "suggestion": { "type": "string" },
          "fingerprint": {
            "$comment": "워크플로가 파일+review_perspective+정규화 제목으로 결정론적 계산. 라인 무관.",
            "type": "string"
          },
          "adoption": {
            "$comment": "lens 가 제시하는 채택 힌트. 안전경계 발견은 중재 게이트가 must_adopt 로 고정(강등 불가).",
            "type": "string",
            "enum": ["must_adopt", "defer", "wont_adopt"]
          },
          "duplicate_of": { "type": ["string", "null"] }
        }
      }
    },
    "rework_brief": {
      "$comment": "blocking 발견의 change-adoption(rules/change-adoption.md) 3분류 재작업 브리프. 가산 필드.",
      "type": "object",
      "additionalProperties": false,
      "required": ["must_adopt", "defer", "wont_adopt"],
      "properties": {
        "must_adopt": { "type": "array", "items": { "type": "object" } },
        "defer": { "type": "array", "items": { "type": "object" } },
        "wont_adopt": { "type": "array", "items": { "type": "object" } }
      }
    },
    "resolved_threads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "reason"],
        "properties": {
          "fingerprint": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "unresolved_threads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "reason"],
        "properties": {
          "fingerprint": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "skipped_duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "duplicate_of", "reason"],
        "properties": {
          "fingerprint": { "type": "string" },
          "duplicate_of": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "context_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "files", "symbols"],
        "properties": {
          "reason": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "symbols": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
